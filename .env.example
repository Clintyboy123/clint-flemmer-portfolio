# Copy this file to .env and fill it in:   cp .env.example .env
# .env holds real passwords and must never be committed or shared.
# Generate each password/secret with:      openssl rand -base64 32

# --- Application -------------------------------------------------------------
NODE_ENV=production
APP_NAME="Clint Flemmer Portfolio"

# Unique per website. Names this site's containers, network and database volume.
# Lowercase letters, numbers, dashes and underscores only, e.g. the domain without dots.
COMPOSE_PROJECT_NAME=clint-flemmer-portfolio

# --- Ports -------------------------------------------------------------------
# The port the VPS-level Nginx forwards this domain to. Must be unique per website on the VPS.
FRONTEND_PORT=8101

# Internal only (never public). If you change it, change it in frontend/nginx/default.conf too.
BACKEND_PORT=3000

# How many proxies sit in front of the API: 2 on the VPS (VPS Nginx + frontend Nginx).
TRUST_PROXY=2

# --- Database ----------------------------------------------------------------
MYSQL_DATABASE=clint_portfolio
MYSQL_USER=clint_portfolio
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# The database's Docker service name and port. Leave as they are.
DB_HOST=database
DB_PORT=3306

# --- Project-specific (add below; authentication secrets, mail settings, ...) --

# Signs the admin login cookie. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-long-random-string

# The admin account, created the first time the site starts (and only then).
# After that, change the password inside the admin; these two lines are no longer read.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-on-first-login
ADMIN_NAME="Clint Flemmer"

# Where uploaded files are stored. Docker sets this to /app/uploads (the "uploads" volume) by itself;
# only change it for a local run outside Docker. Default for local runs: backend/uploads
# UPLOAD_DIR=

# --- Deployment (set on the VPS by GitHub Actions; leave unset on your computer) ---
# The exact images to run, e.g. ghcr.io/<owner>/<repo>-frontend:<commit>. Unset = build locally.
# FRONTEND_IMAGE=
# BACKEND_IMAGE=
